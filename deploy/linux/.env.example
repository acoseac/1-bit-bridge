# Coordinates for deploy-bridge-vps.sh. Copy to `.env` in this directory and
# fill in your own values:
#
#     cp deploy/linux/.env.example deploy/linux/.env
#
# `.env` is ignored by .gitignore's `.env` pattern; this template is kept by
# `!.env.example`. Never put real coordinates in the template -- deploy/ is
# public. Explicit environment variables override anything set here, so a
# one-off run can still be `HOST=... ./deploy/linux/deploy-bridge-vps.sh`.
#
# Addresses below use the RFC 5737 documentation range, matching deploy/README.md.

# REQUIRED -- ssh target for the bridge host.
HOST=user@192.0.2.10

# REQUIRED -- private key for that host. No default: the script will not guess
# a key.
SSH_KEY=$HOME/.ssh/your-bridge-key

# Optional -- extra ssh/scp arguments, word-split. The reason this exists: when
# the workstation's egress is not allowlisted for the host's :22 (see the
# runbook's SSH-flap note), route through a host whose egress IS allowlisted.
# `-J` tunnels only TCP, so the key never leaves the workstation and no binary
# transits the relay. An option whose VALUE contains spaces (a full
# ProxyCommand) belongs in ~/.ssh/config instead.
#SSH_OPTS=-J relay-user@192.0.2.20

# Optional -- defaults to https://<host-without-user@>/v1/health, which is the
# public :443 endpoint and stays reachable even while :22 is filtered.
#HEALTH_URL=https://bridge.example.com/v1/health

# Optional -- path to the binary on the host (default /usr/local/bin/bridge).
#REMOTE_BIN=/usr/local/bin/bridge

# Optional -- timestamped backups to retain after a verified-healthy deploy
# (default 2: the immediate rollback plus one behind it).
#KEEP_BACKUPS=2
