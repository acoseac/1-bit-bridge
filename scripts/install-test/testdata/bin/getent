#!/bin/sh
# getent for the installer's tests: the passwd entry of STUB_USER, its home
# STUB_PASSWD_HOME, else HOME.
printf 'getent %s\n' "$*" >>"${STUB_LOG:?}"
if [ "${1:-}" != passwd ]; then
	exit 2
fi
printf '%s:x:%s:%s:Test:%s:/bin/sh\n' "${2:-tester}" "${STUB_UID:-1000}" "${STUB_UID:-1000}" "${STUB_PASSWD_HOME:-$HOME}"
