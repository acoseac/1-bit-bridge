#!/bin/sh
# id for the installer's tests: STUB_UID and STUB_USER; -nG USER is the
# account's groups as the group database lists them (STUB_GROUPS), and -nG
# alone this process's (STUB_PROCESS_GROUPS, else the account's).
printf 'id %s\n' "$*" >>"${STUB_LOG:?}"
case ${1:-} in
-u) printf '%s\n' "${STUB_UID:-1000}" ;;
-un) printf '%s\n' "${STUB_USER:-tester}" ;;
-nG)
	if [ "$#" -gt 1 ]; then
		if [ "$2" != "${STUB_USER:-tester}" ]; then
			printf "id: '%s': no such user\n" "$2" >&2
			exit 1
		fi
		printf '%s\n' "${STUB_GROUPS:-tester}"
	else
		printf '%s\n' "${STUB_PROCESS_GROUPS:-${STUB_GROUPS:-tester}}"
	fi
	;;
*)
	echo 'stub id: only -u, -un and -nG [user]' >&2
	exit 1
	;;
esac
