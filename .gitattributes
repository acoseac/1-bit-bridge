# The shared playlist parse-case table is compared byte for byte with the iOS
# app's copy; a CRLF checkout (Windows CI) would change every row.
internal/manifest/testdata/playlist-parse-cases.tsv text eol=lf
# The ALSA fixtures are /proc files as a box wrote them, kept LF on every
# checkout so a raw dump of one is the capture's bytes.
internal/alsa/testdata/** text eol=lf
internal/mpd/testdata/** text eol=lf
# The DSD goldens are compared byte for byte; pattern.bin has no NUL byte by
# design, so git would call it text and a CRLF checkout would change it.
internal/player/decode/testdata/dsd-goldens/*.bin binary
internal/player/decode/testdata/dsd-goldens/*.dsf binary
internal/player/decode/testdata/dsd-goldens/*.dff binary
