<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{.Label | xmlEscape}}</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{.BinaryPath | xmlEscape}}</string>
        <string>serve</string>
        <string>--config</string>
        <string>{{.ConfigPath | xmlEscape}}</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{.WorkingDir | xmlEscape}}</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Both streams intentionally point at one log file. launchd opens
         it with two independent FDs (separate write offsets), but the
         bridge logs only to stderr in serve mode (slog -> os.Stderr; see
         logging.Init in cmd/bridge/main.go), so the two never interleave
         or clobber. If serve-mode ever starts writing to stdout, split
         these into distinct paths to avoid corrupting the log. -->
    <key>StandardOutPath</key>
    <string>{{.LogPath | xmlEscape}}</string>

    <key>StandardErrorPath</key>
    <string>{{.LogPath | xmlEscape}}</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
