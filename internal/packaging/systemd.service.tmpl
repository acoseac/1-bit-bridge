[Unit]
Description=1-bit-bridge — companion server for the 1-bit iOS app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="{{.BinaryPath | systemdEscape}}" serve --config "{{.ConfigPath | systemdEscape}}"
WorkingDirectory="{{.WorkingDir | systemdEscape}}"
Restart=always
RestartSec=2
StandardOutput=append:"{{.LogPath | systemdEscape}}"
StandardError=append:"{{.LogPath | systemdEscape}}"

[Install]
WantedBy=default.target
