[Unit]
Description=1-bit-bridge — companion server for the 1-bit iOS app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="{{.BinaryPath | systemdEscapeExec}}" serve --config "{{.ConfigPath | systemdEscapeExec}}"
WorkingDirectory={{.WorkingDir | systemdEscapePath}}
Restart=always
RestartSec=2
StandardOutput=append:{{.LogPath | systemdEscapePath}}
StandardError=append:{{.LogPath | systemdEscapePath}}

[Install]
WantedBy=default.target
