# Go build artifacts
/bin/
/dist/
/bridge
*.exe
*.test
*.out

# Release artifact: written to repo root by goreleaser's before-hook
# so it doesn't trip the dist-must-be-empty check; uploaded as a
# Release asset via release.extra_files.
/release-meta.json

# Runtime state (local dev)
/bridge.db
/bridge.db-*
/data/
*.pem
*.key
*.crt

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local config
/.claude/

# Docker compose local overrides + the operator's env file. `.env` may hold
# secrets (TS_AUTHKEY, etc.) — never commit it. The `.env.example` template
# IS committed (the `!` re-includes it).
.env
.env.*
!.env.example
/compose.override.yaml
/compose.override.yml
/docker-compose.override.yaml
/docker-compose.override.yml
