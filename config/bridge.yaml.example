# 1-bit-bridge sample config. Copy to bridge.yaml and edit for your machine.
#
# libraryRoots:    absolute paths the server will expose. All client paths are
#                  resolved relative to one of these; traversal (..) is rejected.
# listenAddress:   host:port to bind the HTTPS server on. Default :7788.
# tlsCertPath,
# tlsKeyPath:      optional. If unset, the server mints a self-signed cert on
#                  first run and stores it next to bridge.db.
# dataDir:         where bridge.db, TLS material, and token hashes live.
# scanIntervalSec: full rewalk interval; fsnotify handles incremental updates
#                  between rewalks. Default 3600 (1 hour).
# libraryName:     human-readable name shown in the iOS pairing UI + mDNS TXT.

libraryRoots:
  - /Users/me/Music

listenAddress: ":7788"

dataDir: "./data"

# tlsCertPath: "./data/server.crt"
# tlsKeyPath:  "./data/server.key"

scanIntervalSec: 3600

libraryName: "My Music Library"

# deployment.mode: "loopback" (default) | "public"
#
# loopback (default): admin console binds 127.0.0.1, no auth — the
#   historical home-LAN posture. Anyone on the host already owns the
#   token store + SQLite DB, so adding auth on top would be theatre.
#
# public: VPS deployment posture. Admin console accepts non-loopback
#   binds and gates every request behind a session cookie
#   (bcrypt-hashed credentials at <dataDir>/adminauth.json). REQUIRES:
#     - autocert.domain                              (the publicly-routable hostname iOS dials)
#     - ONE OF: autocert.enabled (bridge mints LE cert) OR
#               deployment.adminTLSTerminatedByProxy (Caddy/nginx fronts TLS)
#     - When autocert.enabled: listenAddress on :443 OR
#       autocert.external443Mapping (operator runs an external
#       port-forward mapping WAN:443 → bridge's listenAddress).
#       LE's TLS-ALPN-01 challenge is only validated on TCP/443.
#     - Run `bridge admin reset-password` (or `bridge init --public`)
#       before `bridge serve` — refuses to start without credentials.
#
# === Variant A — bridge terminates TLS itself via autocert ===
# deployment:
#   mode: public
# autocert:
#   enabled: true
#   domain: bridge.example.com
#   email: ops@example.com
#   # cacheDir: ""        # defaults to <dataDir>/acme
#   # useStaging: false   # opt-in for LE staging during dev
#   # external443Mapping: false  # set true if WAN:443 maps to a non-:443 listenAddress
#
# === Variant B — reverse proxy (Caddy / nginx) terminates TLS ===
# deployment:
#   mode: public
#   adminTLSTerminatedByProxy: true
# autocert:
#   domain: bridge.example.com

# enrich: override where the background enricher fetches cover art +
#   MusicBrainz IDs. Both empty by default (public MusicBrainz + Cover Art
#   Archive). Point them at a self-hosted Atlas mirror
#   (github.com/acoseac/1-bit-atlas) to keep enrichment on your own network.
#   Also settable in the admin console (Settings -> General -> Metadata
#   enrichment) and via BRIDGE_MUSICBRAINZ_BASE_URL / BRIDGE_COVERART_BASE_URL.
# enrich:
#   musicbrainzBaseURL: "https://atlas.example.com/ws/2"
#   coverArtBaseURL: "https://atlas.example.com"

# atlas: optional RICH-tier metadata (artist bios, album descriptions, genres).
#   Disabled by default. Distinct from `enrich` above (artwork + MusicBrainz
#   source): when enabled, the bridge accepts metadata pushed by the 1-bit app
#   (which holds the Atlas access key — the open-source bridge never does) via
#   POST /v1/atlas-ingest and serves it back via GET /v1/atlas-meta/* to all
#   your devices. Also toggleable in the admin console (Settings -> General ->
#   Metadata enrichment). metaTtlHours is the freshness window (default 720).
# atlas:
#   enabled: true
#   metaTtlHours: 720
