# 1-bit-bridge — Docker environment overrides.
#
# Copy this file to ".env" (same directory as compose.yaml) and edit. Docker
# Compose auto-loads ".env", so `docker compose up -d` picks these up. Every
# value here is OPTIONAL — with no .env at all the container boots on sane
# defaults (single library at ./music, HTTP/2 + HTTP/3 on :7788, audio off).
#
# These map to the bridge's BRIDGE_* runtime overrides: env beats bridge.yaml
# beats built-in defaults. Booleans use Go's strconv.ParseBool — true/false
# (also 1/0, t/f). A value it can't parse (yes/on) is IGNORED, not read as
# false. Full reference: docs/docker.md → "Environment overrides".
#
# Keep your real .env private — it is git-ignored and never baked into an
# image. Do not commit it (it may hold a TS_AUTHKEY or other secrets).

# --- Library ---------------------------------------------------------------

# HOST path to your music folder (the left side of the read-only bind-mount in
# compose.yaml). This is the one knob almost everyone sets.
#BRIDGE_LIBRARY_HOST_PATH=/mnt/music

# Display name shown in the iOS app.
#BRIDGE_LIBRARY_NAME=Living Room

# Container-side roots. The default /library matches the mount in compose.yaml.
# For MULTIPLE libraries: add more `- /host/path2:/library2:ro` volume lines to
# compose.yaml, then list them colon-separated here.
#BRIDGE_LIBRARY_ROOTS=/library:/library2

# --- Optional audio features (bundled sox + ffmpeg + fpcalc) ---------------
# Off by default; cost nothing until enabled. See docs/docker.md.

#BRIDGE_UPSCALE_ENABLED=true
#BRIDGE_ANALYSIS_ENABLED=true

# Acoustic fingerprinting: identifies a recording from the audio itself when
# tags are too poor for a MusicBrainz text match. Needs ACOUSTID_API_KEY below
# as well — enabling it without one degrades to off with a line in the log.
#BRIDGE_FINGERPRINT_ENABLED=true

# --- Networking ------------------------------------------------------------

# Local timezone for the auto-updater quiet-hours window (e.g. Europe/Helsinki).
#TZ=UTC

# Disable HTTP/3 (QUIC). If you set this true, also drop the "7788:7788/udp"
# line from compose.yaml.
#BRIDGE_DISABLE_HTTP3=false

# Changing the LISTEN address (BRIDGE_LISTEN_ADDRESS, default :7788) also means
# editing the published `ports:` in compose.yaml to match, so it's an
# edit-the-compose-file change rather than a .env knob — left out on purpose.

# --- Advanced --------------------------------------------------------------

# Point enrichment (metadata + cover art) at a self-hosted Atlas instead of the
# public MusicBrainz / Cover Art Archive. Set BOTH together.
#BRIDGE_MUSICBRAINZ_BASE_URL=https://atlas.example.com/ws/2
#BRIDGE_COVERART_BASE_URL=https://atlas.example.com

# Tailscale embedded-node (tsnet) auth key for headless first-auth — see
# docs/docker.md → "Tailscale (tsnet)". Requires `tailscale.mode: tsnet` in
# bridge.yaml. Secret — keep it out of version control.
#TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxx

# AcoustID application key for the acoustic-fingerprinting fallback. Register
# free at https://acoustid.org/new-application. Secret — keep it out of version
# control. The bridge ships no built-in key on purpose: one embedded in an
# open-source binary is shared by every install, which is how it gets
# rate-limited and revoked for everyone.
#ACOUSTID_API_KEY=xxxxxxxxxx

# The admin-address override is intentionally NOT offered here: the admin
# console is unauthenticated and MUST bind loopback — a non-loopback value
# makes the bridge refuse to start. Reach it via `docker exec` or a reverse
# proxy (docs/docker.md → "Admin console access").
